@startuml sequence-notation
skinparam backgroundColor transparent
skinparam defaultFontSize 13
skinparam shadowing false
skinparam ParticipantBorderColor #2e86c1
skinparam ParticipantBackgroundColor #eaf2f8
skinparam SequenceLifeLineBorderColor #2e86c1
skinparam ArrowColor #1a5276

title Sequence Diagram Notation

actor User
participant "Client" as C
participant "Server" as S
database "Database" as D

User -> C : 1. request()
activate C
C -> S : 2. sendRequest()
activate S
S -> D : 3. query()
activate D
D --> S : 4. result
deactivate D
S --> C : 5. response
deactivate S
C --> User : 6. display()
deactivate C

@enduml
