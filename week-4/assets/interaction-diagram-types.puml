@startuml interaction-diagram-types
skinparam backgroundColor transparent
skinparam defaultFontSize 13
skinparam shadowing false
skinparam rectangleBorderColor #2e86c1
skinparam rectangleFontColor #1a5276
skinparam packageBorderColor #1a5276

title Interaction Diagram Types

package "Interaction Diagrams" as id #eaf2f8 {
  rectangle "**Sequence Diagram**\nTime-ordered messages\nbetween lifelines" as seq #d5f5e3

  rectangle "**Collaboration Diagram**\nObject architecture\n& connections" as col #d6eaf8

  rectangle "**Timing Diagram**\nState changes over\ntime with constraints" as tim #fdebd0

  rectangle "**Interaction Overview**\nMix of activity +\nsequence diagrams" as iov #fadbd8
}

@enduml
