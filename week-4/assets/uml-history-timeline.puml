@startuml uml-history-timeline
skinparam backgroundColor transparent
skinparam defaultFontSize 13
skinparam shadowing false
skinparam ArrowColor #2e86c1
skinparam rectangleBorderColor #2e86c1
skinparam rectangleFontColor #1a5276

title UML History & Evolution

rectangle "**1991-93**\nBooch Method\nOMT (Rumbaugh)\nOOSE (Jacobson)" as era1 #d5f5e3

rectangle "**1994-95**\nUnified Method\n@ Rational Software\n(Booch + Rumbaugh + Jacobson)" as era2 #d6eaf8

rectangle "**1996**\nUML 0.9\nPartners join:\nHP, IBM, Microsoft" as era3 #fdebd0

rectangle "**1997**\nUML 1.0\nAdopted by OMG\nas standard" as era4 #fadbd8

rectangle "**2005**\nUML 2.0\n14 diagram types\nISO/IEC 19501" as era5 #e8daef

rectangle "**Today**\nUML 2.5+\nWidely used in\nSoftware Engineering" as era6 #f9e79f

era1 -right-> era2
era2 -right-> era3
era3 -right-> era4
era4 -right-> era5
era5 -right-> era6

@enduml
