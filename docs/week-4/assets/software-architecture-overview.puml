@startuml software-architecture-overview
skinparam backgroundColor transparent
skinparam defaultFontSize 13
skinparam shadowing false
skinparam rectangleBorderColor #2e86c1
skinparam rectangleFontColor #1a5276
skinparam packageBorderColor #1a5276
skinparam ArrowColor #1a5276

title Software Architecture Concerns

rectangle "**Software Architecture**" as sa #eaf2f8 {
  rectangle "What will the\nsystem be used for?" as q1 #d5f5e3
  rectangle "Who will be\nusing the system?" as q2 #d5f5e3
  rectangle "What quality\nmatters to them?" as q3 #fdebd0
  rectangle "Where will the\nsystem run?" as q4 #fdebd0
}

rectangle "**Benefits**" as ben #d6eaf8 {
  rectangle "High\nProductivity" as b1
  rectangle "Easier\nMaintenance" as b2
  rectangle "Clear\nStructure" as b3
}

sa -down-> ben

@enduml
