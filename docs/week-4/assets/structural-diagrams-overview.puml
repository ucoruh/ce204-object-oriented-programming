@startuml structural-diagrams-overview
skinparam backgroundColor transparent
skinparam defaultFontSize 13
skinparam shadowing false
skinparam rectangleBorderColor #2e86c1
skinparam rectangleFontColor #1a5276
skinparam packageBorderColor #1a5276

title Structural Diagrams

package "Structural Diagrams" as sd #eaf2f8 {
  rectangle "**Class**\nDiagram" as cls #d5f5e3
  rectangle "**Object**\nDiagram" as obj #d5f5e3
  rectangle "**Package**\nDiagram" as pkg #d6eaf8
  rectangle "**Component**\nDiagram" as cmp #d6eaf8
  rectangle "**Deployment**\nDiagram" as dep #fdebd0
  rectangle "**Composite\nStructure**" as cs #fdebd0
}

note bottom of sd
  Structural diagrams depict the
  **static view** of a system
end note

@enduml
