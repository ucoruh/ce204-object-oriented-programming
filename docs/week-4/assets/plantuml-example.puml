@startuml plantuml-example
skinparam backgroundColor transparent
skinparam defaultFontSize 14
skinparam shadowing false
skinparam ClassBorderColor #2e86c1
skinparam ClassBackgroundColor #eaf2f8
skinparam ClassHeaderBackgroundColor #2e86c1
skinparam ClassHeaderFontColor white
skinparam ArrowColor #1a5276

title PlantUML Example: Simple Class Diagram

class Animal {
  - name: String
  - age: int
  + eat()
  + sleep()
  + makeSound()
}

class Dog {
  - breed: String
  + fetch()
  + makeSound()
}

class Cat {
  - indoor: boolean
  + purr()
  + makeSound()
}

Animal <|-- Dog
Animal <|-- Cat

@enduml
