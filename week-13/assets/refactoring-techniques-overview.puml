@startuml refactoring-techniques-overview
!theme plain
skinparam backgroundColor #FEFEFE
skinparam defaultFontSize 13
skinparam defaultFontName "Segoe UI"
skinparam shadowing false
skinparam RoundCorner 10

title Refactoring Techniques Overview (66 Techniques)

@startmindmap
<style>
mindmapDiagram {
    node {
        Padding 8
        Margin 3
        RoundCorner 10
        FontSize 12
    }
    :depth(0) {
        BackgroundColor #2C3E50
        FontColor #FFFFFF
        FontSize 14
        FontStyle bold
    }
    :depth(1) {
        FontSize 13
        FontStyle bold
    }
    :depth(2) {
        BackgroundColor #ECF0F1
        FontColor #2C3E50
        FontSize 11
    }
}
</style>

