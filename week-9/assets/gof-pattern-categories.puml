@startmindmap
skinparam backgroundColor #FEFEFE
skinparam shadowing false

<style>
mindmapDiagram {
    node {
        BackgroundColor #E8F4FD
        FontSize 13
        RoundCorner 10
        Padding 8
        Margin 4
    }
    :depth(0) {
        BackgroundColor #2C3E50
        FontColor white
        FontSize 16
        FontStyle bold
    }
    :depth(1) {
        BackgroundColor #3498DB
        FontColor white
        FontSize 14
        FontStyle bold
    }
    :depth(2) {
        FontSize 12
    }
}
</style>

